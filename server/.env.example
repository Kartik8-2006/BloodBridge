# ───────── Server ─────────
NODE_ENV=development
PORT=4000
# Where the React app runs (used for CORS)
CLIENT_URL=http://localhost:5173

# ───────── Supabase Postgres ─────────
# Supabase dashboard → Connect → "Transaction pooler" string (port 6543). Used by the running API.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Same dashboard → "Session pooler" string (port 5432). Used only by `npm run db:push`.
DIRECT_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ───────── Supabase Storage (hospital license documents) ─────────
# Project Settings → API → Project URL and the service_role key. NEVER expose the service_role key to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hospital-documents

# ───────── Clerk ─────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Comma separated. Anyone signing in with one of these VERIFIED emails becomes ADMIN.
ADMIN_EMAILS=you@example.com

# ───────── OpenStreetMap etiquette ─────────
# Overpass and Nominatim ask for a contact address in the User-Agent.
OSM_CONTACT_EMAIL=you@example.com

# ───────── Gemini (optional; AI chat, triage and forecast narrative) ─────────
# Google AI Studio → Get API key. Leave empty to switch the AI features off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ───────── Razorpay (optional; hospital Pro subscription, test mode works) ─────────
# Dashboard → Settings → API Keys. Leave empty to switch billing off (everything stays unlocked).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → add https://YOUR-API/api/billing/webhook, event payment.captured, copy its secret here
RAZORPAY_WEBHOOK_SECRET=
# Prices in paise: 99900 = ₹999.00
PRO_MONTHLY_PAISE=99900
PRO_YEARLY_PAISE=999000
